# Copiez ce fichier vers .env à la racine du projet (ou utilisez .vite/.env).
# Ne commitez jamais .env avec une vraie clé.

OPENROUTER_API_KEY=

# Modèle gratuit (liste change sur OpenRouter — repli auto côté server.js si 404/429)
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free

# Optionnel :
# PORT=8080
# SITE_URL=http://localhost:8080
